{ pkgs, config, libs, ... }:


{
networking.nameservers = [ "1.1.1.1" "9.9.9.9" ];
networking.firewall = {
  enable = true;
  allowedTCPPorts = [ 80 443 8096 ];
  allowedUDPPortRanges = [
   # { from = 4000; to = 4007; }
    { from = 8096; to = 8096; }
  ];
};


 services.nginx = {
    enable = true;
    recommendedProxySettings = true;
    recommendedTlsSettings = true;

    virtualHosts."jellyfin.jonzuk.org" = {
      forceSSL = true;
      enableACME = true;
      locations."/" = {
        proxyPass = "http://localhost:8096";
        proxyWebsockets = true;
      };
    };
  };


  security.acme = {
    acceptTerms = true;
    defaults.email = "jonzukspam@protonmail.com";
  };






}

